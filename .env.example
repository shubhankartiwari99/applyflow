# Local development can use the in-memory store and preview the OTP in the UI.
ALLOW_DEMO_AUTH=true

# Production: provision Neon through Vercel Marketplace and copy DATABASE_URL.
DATABASE_URL=

# Production-only signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Production: provision Resend and use a verified sender address/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ApplyFlow <no-reply@example.com>

# AI-powered cover letter generation (optional — falls back to template if not set).
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
